{
  "name": "sermon-manager",
  "private": true,
  "packageManager": "bun@1.0.0",
  "scripts": {
    "dev:ts": "tsc --watch",
    "build": "tsc",
    "check": "tsc && tsc -p tsconfig.api.json && node --test tests/*.test.cjs",
    "test": "tsc -p tsconfig.api.json && node --test tests/*.test.cjs",
    "deploy": "vercel --prod",
    "deploy:cloud": "vercel --prod --yes --token=\"$VERCEL_TOKEN\""
  },
  "devDependencies": {
    "@types/busboy": "^1.5.0",
    "@types/node": "^20.0.0",
    "@vercel/node": "^3.0.0",
    "prettier": "3.8.1",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1002.0",
    "@aws-sdk/s3-request-presigner": "3.1002.0",
    "busboy": "^1.6.0",
    "vercel": "^59.23.2"
  }
}
