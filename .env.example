# Cloudflare R2 credentials and bucket configuration
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key
R2_SECRET_ACCESS_KEY=your_r2_secret_key
R2_BUCKET_NAME=sermons
R2_PUBLIC_URL=https://pub-xxxx.r2.dev

# Use independent, strong values for the administrator password and cookie signing.
ADMIN_PASSWORD=choose_a_strong_password_here
ADMIN_SESSION_SECRET=choose_a_different_random_string_here

# Only required when deploying from an unattended environment such as Codex Cloud
VERCEL_TOKEN=your_vercel_access_token
VERCEL_ORG_ID=your_vercel_team_or_user_id
VERCEL_PROJECT_ID=your_vercel_project_id
